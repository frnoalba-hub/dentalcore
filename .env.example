# Copy to `.env` or set in your host’s build environment (Vercel/Netlify/etc.).
#
# Facebook Sharing Debugger expects og:fb:app_id / fb:app_id for some checks.
# Create a Meta app: https://developers.facebook.com/apps/
# Use the numeric App ID (Settings → Basic). This is public; do not use the App Secret here.
#
# VITE_FB_APP_ID=1234567890123456

# Google Tag Manager (public container ID, e.g. GTM-XXXX)
# VITE_GTM_ID=GTM-XXXXXXX

# Google Ads conversion tag / Global Site Tag ID (e.g. DC-XXXXXXXX or AW-XXXXXXXXX)
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
