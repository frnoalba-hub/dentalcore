{
  "name": "QuoteRequest",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "Public-facing quote request ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "quoted",
        "won",
        "lost"
      ],
      "default": "new",
      "description": "Sales pipeline stage"
    },
    "source": {
      "type": "string",
      "description": "Origin location for attribution"
    },
    "source_page_url": {
      "type": "string",
      "description": "URL where user started quote request"
    },
    "contact_name": {
      "type": "string",
      "description": "Lead contact name"
    },
    "office_name": {
      "type": "string",
      "description": "Office or practice name"
    },
    "email": {
      "type": "string",
      "description": "Lead email"
    },
    "phone": {
      "type": "string",
      "description": "Lead phone"
    },
    "need_by": {
      "type": "string",
      "format": "date",
      "description": "Requested need-by date"
    },
    "request_details": {
      "type": "string",
      "description": "Products and quantity details from lead"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes from lead"
    },
    "product_id": {
      "type": "string",
      "description": "Single-product flow product ID"
    },
    "product_name": {
      "type": "string",
      "description": "Single-product flow product name"
    },
    "product_sku": {
      "type": "string",
      "description": "Single-product flow SKU"
    },
    "variant_id": {
      "type": "string",
      "description": "Variant ID if selected"
    },
    "variant_name": {
      "type": "string",
      "description": "Variant label if selected"
    },
    "quantity": {
      "type": "integer",
      "description": "Requested quantity for single-product flow"
    },
    "cart_items": {
      "type": "array",
      "description": "Cart-origin quote line items",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "unitPrice": {
            "type": "number"
          }
        }
      }
    },
    "estimated_total": {
      "type": "number",
      "description": "Estimated total shown to user"
    }
  },
  "required": [
    "request_id",
    "status",
    "contact_name",
    "request_details"
  ]
}
