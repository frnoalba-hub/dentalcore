{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "Public-facing order ID"
    },
    "email": {
      "type": "string",
      "description": "Customer email"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer full name"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "processing",
        "shipped",
        "out_for_delivery",
        "delivered"
      ],
      "default": "confirmed",
      "description": "Current order status"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "description": "Order line items"
    },
    "total": {
      "type": "number",
      "description": "Order total"
    },
    "tracking_number": {
      "type": "string",
      "description": "Shipping tracking number"
    },
    "carrier": {
      "type": "string",
      "description": "Shipping carrier name"
    },
    "estimated_delivery": {
      "type": "string",
      "format": "date",
      "description": "Estimated delivery date"
    },
    "shipped_date": {
      "type": "string",
      "format": "date",
      "description": "Date the order was shipped"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes"
    }
  },
  "required": [
    "order_id",
    "email",
    "status"
  ]
}