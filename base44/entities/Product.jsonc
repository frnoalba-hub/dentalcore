{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "category": {
      "type": "string",
      "description": "Product category"
    },
    "price": {
      "type": "string",
      "description": "Product price"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "image": {
      "type": "string",
      "description": "Main product image URL"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional product images"
    },
    "popular": {
      "type": "boolean",
      "default": false,
      "description": "Featured/popular product"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product features"
    },
    "specs": {
      "type": "object",
      "additionalProperties": true,
      "description": "Technical specifications"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string"
          },
          "rating": {
            "type": "integer"
          },
          "text": {
            "type": "string"
          },
          "date": {
            "type": "string"
          }
        }
      },
      "description": "Customer reviews"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sku": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "additionalProperties": true,
            "description": "Variant options like size, color, material"
          },
          "image": {
            "type": "string"
          },
          "stock": {
            "type": "integer"
          }
        }
      },
      "description": "Product variants"
    }
  },
  "required": [
    "name",
    "category",
    "price",
    "description",
    "image"
  ]
}